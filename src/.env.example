# OpenRouter API key — get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# OpenRouter model to use — see https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# PostgreSQL connection string — asyncpg driver required for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://docmind:secret@localhost:5432/docmind

# SentenceTransformer model name — 384-dimensional embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of top chunks to retrieve for each query
TOP_K=5

# Maximum characters per text chunk (not tokens — approximate)
CHUNK_SIZE=512

# Character overlap between consecutive chunks to preserve context
CHUNK_OVERLAP=50

# claude --resume 5f81e931-92c2-4487-82fe-8da31d891610