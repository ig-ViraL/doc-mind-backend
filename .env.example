# OpenRouter API key — get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# OpenRouter model to use — see https://openrouter.ai/models
# Free fast option (default): meta-llama/llama-3.1-8b-instruct:free
# Paid higher quality:        anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# PostgreSQL connection string — asyncpg driver required for async SQLAlchemy
# On Railway: copy the DATABASE_URL from the Postgres plugin (postgresql:// is auto-corrected)
DATABASE_URL=postgresql+asyncpg://docmind:secret@localhost:5432/docmind

# Embeddings: "local" = in-process sentence-transformers model, "voyage" = Voyage AI API
# Default local model: Qwen/Qwen3-Embedding-0.6B (1024 dims) on the Mac GPU (MPS) in fp16.
# After changing the model or dim, run: python scripts/reindex.py
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=auto        # auto | mps | cuda | cpu
EMBEDDING_FP16=true
# VOYAGE_API_KEY=pa-...   # only if EMBEDDING_PROVIDER=voyage (set EMBEDDING_DIM=512 for voyage-3-lite)

# Cross-encoder reranker (multilingual, 568M params)
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_FP16=true

# Number of top chunks to retrieve for each query
TOP_K=5

# Chunk size in tokens (counted with the embedding model's tokenizer)
CHUNK_SIZE=400

# Token overlap between consecutive chunks (whole words/sentences only)
CHUNK_OVERLAP=60

# Candidate pool fetched by hybrid search and reranked before keeping TOP_K
RETRIEVAL_K=50

# LLM request timeout (seconds) and retries
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
