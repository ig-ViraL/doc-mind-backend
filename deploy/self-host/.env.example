# Copy to .env on the VM and fill in. Never commit .env.
DOCMIND_HOST=docmind-api.viral-deshle.cloud
MCP_HOST=mcp.viral-deshle.cloud

DOCMIND_DATABASE_URL=            # Neon pooled connection string
OPENROUTER_API_KEY=              # new key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

DEMO_DB_ADMIN_PASSWORD=          # openssl rand -hex 16
DEMO_DB_READONLY_PASSWORD=       # openssl rand -hex 16
MCP_SHARED_SECRET=               # openssl rand -hex 32  (same value goes into Vercel MCP_SHARED_SECRET)
